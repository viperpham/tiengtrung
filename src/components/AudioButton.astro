---
interface Props {
  src: string;
  text?: string;
  class?: string;
}

const { src, text = '', class: className = '' } = Astro.props;
const id = `audio-${src.replace(/[^a-z0-9]/gi, '-')}`;
---

<button
  id={id}
  type="button"
  data-audio-src={src}
  data-hanzi={text}
  class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-red-600 text-white transition hover:bg-red-700 active:scale-95"
  aria-label="Phát âm"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
    <path d="M8 5v14l11-7z" />
  </svg>
</button>

<script>
  const players = new Map<string, HTMLAudioElement>();

  function speakWithDevice(text: string) {
    const synth = window.speechSynthesis;
    if (!synth) return false;
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'zh-CN';
    const voice = synth.getVoices().find((v) => v.lang.toLowerCase().startsWith('zh'));
    if (voice) utterance.voice = voice;
    synth.cancel();
    synth.speak(utterance);
    return true;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-audio-src]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.audioSrc!;
      let audio = players.get(src);
      if (!audio) {
        audio = new Audio(src);
        players.set(src, audio);
      }
      audio.currentTime = 0;
      audio.play().catch(() => {
        if (!speakWithDevice(btn.dataset.hanzi || '')) {
          alert('Chưa có file audio: ' + src);
        }
      });
    });
  });
</script>
