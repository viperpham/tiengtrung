---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VocabCard from '../../../components/VocabCard.astro';
import levels from '../../../data/levels.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return levels.map((lv) => ({
    params: { level: lv.code.toLowerCase() },
    props: { lv },
  }));
}

const { lv } = Astro.props;
const level = lv.code;

const [allLessons, allVocab, allGrammar, allQuizzes] = await Promise.all([
  getCollection('lessons'),
  getCollection('vocabulary'),
  getCollection('grammar'),
  getCollection('quizzes'),
]);

const lessons = allLessons
  .filter((l) => l.data.level === level)
  .sort((a, b) => a.data.order - b.data.order);
const vocab = allVocab
  .filter((v) => v.data.level === level)
  .sort((a, b) => a.data.order - b.data.order);
const grammar = allGrammar.filter((g) => g.data.level === level);
const quizzes = allQuizzes.filter((q) => q.data.level === level);
---

<BaseLayout title={`${lv.name} — Học tiếng Trung`} description={lv.desc}>
  <nav class="text-sm text-slate-500">
    <a href="/" class="hover:text-red-600">Trang chủ</a> <span class="mx-1">/</span>
    <span class="font-medium text-slate-700">{lv.name}</span>
  </nav>

  <header class="mt-4">
    <h1 class="text-3xl font-bold text-slate-900">{lv.name} <span class="hanzi text-red-600">· 汉语</span></h1>
    <p class="mt-1 text-slate-500">{lv.desc}</p>
  </header>

  <section class="mt-8">
    <h2 class="text-xl font-bold text-slate-900">Bài học</h2>
    {
      lessons.length === 0 ? (
        <p class="mt-3 rounded-xl bg-amber-50 p-4 text-sm text-amber-700">
          Chưa có bài học nào cho cấp độ này.
        </p>
      ) : (
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {lessons.map((lesson) => (
            <a
              href={`/hsk/${level.toLowerCase()}/${lesson.id}`}
              class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-red-300 hover:shadow-md"
            >
              <p class="text-xs font-semibold uppercase tracking-wide text-red-600">
                Bài {lesson.data.order}
              </p>
              <h3 class="mt-1 font-bold text-slate-900 group-hover:text-red-700">{lesson.data.title}</h3>
              <p class="mt-2 text-sm text-slate-500">{lesson.data.description}</p>
            </a>
          ))}
        </div>
      )
    }
  </section>

  {
    quizzes.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-bold text-slate-900">Kiểm tra</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {quizzes.map((q) => (
            <a
              href={`/quiz/${q.id}`}
              class="rounded-2xl border border-blue-200 bg-blue-50 p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <h3 class="font-bold text-blue-900">{q.data.title}</h3>
              <p class="mt-1 text-sm text-blue-600">{q.data.questions.length} câu hỏi · Làm ngay</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-10">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold text-slate-900">Từ vựng ({vocab.length})</h2>
      <a
        href="/flashcards"
        class="rounded-full bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700"
      >
        Học bằng Flashcard
      </a>
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {vocab.map((v) => <VocabCard {...v.data} />)}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-900">Ngữ pháp</h2>
    <div class="mt-4 space-y-4">
      {
        grammar.map((g) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="font-bold text-slate-900">{g.data.title}</h3>
            <p class="mt-2 inline-block rounded-lg bg-red-50 px-3 py-1 font-medium text-red-700">
              {g.data.structure}
            </p>
            <p class="mt-3 text-sm text-slate-600">{g.data.explanation}</p>
            <ul class="mt-4 space-y-3">
              {g.data.examples.map((ex) => (
                <li class="border-l-2 border-red-200 pl-4">
                  <p class="hanzi text-lg text-slate-800">{ex.hanzi}</p>
                  <p class="text-sm text-red-500/90">{ex.pinyin}</p>
                  <p class="text-sm text-slate-500">{ex.meaning}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
