---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VocabCard from '../../../components/VocabCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { level: lesson.data.level.toLowerCase(), lesson: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content: LessonContent } = await render(lesson);

const [allVocab, allGrammar, allQuizzes] = await Promise.all([
  getCollection('vocabulary'),
  getCollection('grammar'),
  getCollection('quizzes'),
]);

const vocab = allVocab
  .filter((v) => v.data.lesson === lesson.id)
  .sort((a, b) => a.data.order - b.data.order);
const grammar = allGrammar.filter((g) => g.data.lesson === lesson.id);
const quizzes = allQuizzes.filter((q) => q.data.lesson === lesson.id);
---

<BaseLayout title={`${lesson.data.title} — Học tiếng Trung`} description={lesson.data.description}>
  <nav class="text-sm text-slate-500">
    <a href="/" class="hover:text-red-600">Trang chủ</a> <span class="mx-1">/</span>
    <a href={`/hsk/${lesson.data.level.toLowerCase()}`} class="hover:text-red-600"
      >{lesson.data.level}</a
    >
    <span class="mx-1">/</span>
    <span class="font-medium text-slate-700">Bài {lesson.data.order}</span>
  </nav>

  <header class="mt-4 rounded-3xl bg-gradient-to-br from-red-600 to-red-800 px-6 py-10 text-white shadow-lg">
    <p class="text-sm font-semibold uppercase tracking-wide text-red-200">
      {lesson.data.level} · Bài {lesson.data.order}
    </p>
    <h1 class="mt-1 text-3xl font-bold">{lesson.data.title}</h1>
    <p class="mt-2 text-red-100">{lesson.data.description}</p>
  </header>

  <div class="mt-8 max-w-none space-y-4 leading-relaxed text-slate-700">
    <LessonContent />
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-900">Từ vựng bài học ({vocab.length} từ)</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {vocab.map((v) => <VocabCard {...v.data} />)}
    </div>
  </section>

  {
    grammar.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-bold text-slate-900">Ngữ pháp bài học</h2>
        <div class="mt-4 space-y-4">
          {grammar.map((g) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="font-bold text-slate-900">{g.data.title}</h3>
              <p class="mt-2 inline-block rounded-lg bg-red-50 px-3 py-1 font-medium text-red-700">
                {g.data.structure}
              </p>
              <p class="mt-3 text-sm text-slate-600">{g.data.explanation}</p>
              <ul class="mt-4 space-y-3">
                {g.data.examples.map((ex) => (
                  <li class="border-l-2 border-red-200 pl-4">
                    <p class="hanzi text-lg text-slate-800">{ex.hanzi}</p>
                    <p class="text-sm text-red-500/90">{ex.pinyin}</p>
                    <p class="text-sm text-slate-500">{ex.meaning}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    quizzes.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-bold text-slate-900">Kiểm tra bài học</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {quizzes.map((q) => (
            <a
              href={`/quiz/${q.id}`}
              class="rounded-2xl border border-blue-200 bg-blue-50 p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <h3 class="font-bold text-blue-900">{q.data.title}</h3>
              <p class="mt-1 text-sm text-blue-600">{q.data.questions.length} câu hỏi · Làm ngay</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
