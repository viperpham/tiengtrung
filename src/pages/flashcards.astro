---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Flashcard — Học tiếng Trung">
  <header class="text-center">
    <h1 class="text-3xl font-bold text-slate-900">Flashcard <span class="hanzi text-red-600">· 闪卡</span></h1>
    <p class="mt-2 text-slate-500">
      Lật thẻ để kiểm tra — tiến độ được lưu trên máy bạn (localStorage)
    </p>
  </header>

  <div class="mx-auto mt-6 max-w-xl">
    <div class="flex items-center justify-between gap-3">
      <label class="text-sm font-medium text-slate-600">Cấp độ:</label>
      <select id="fc-level" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm">
        <option value="">Tất cả</option>
        <option value="HSK1">HSK 1</option>
        <option value="HSK2">HSK 2</option>
        <option value="HSK3">HSK 3</option>
        <option value="HSK4">HSK 4</option>
        <option value="HSK5">HSK 5</option>
        <option value="HSK6">HSK 6</option>
      </select>
    </div>

    <div id="fc-stats" class="mt-4 grid grid-cols-3 gap-3 text-center text-sm">
      <div class="rounded-xl border border-slate-200 bg-white p-3">
        <p class="text-xl font-bold text-slate-900" id="fc-total">0</p>
        <p class="text-slate-500">Tổng thẻ</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-3">
        <p class="text-xl font-bold text-red-600" id="fc-due">0</p>
        <p class="text-slate-500">Đến hạn ôn</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-3">
        <p class="text-xl font-bold text-green-600" id="fc-learned">0</p>
        <p class="text-slate-500">Đã thuộc</p>
      </div>
    </div>

    <div
      id="fc-card"
      class="mt-6 flex min-h-64 cursor-pointer flex-col items-center justify-center rounded-3xl border border-slate-200 bg-white p-10 text-center shadow-md transition select-none hover:shadow-lg"
    >
      <p id="fc-hanzi" class="hanzi text-6xl font-bold text-slate-900"></p>
      <div id="fc-back" class="hidden">
        <p id="fc-pinyin" class="mt-3 text-xl font-medium text-red-600"></p>
        <p id="fc-meaning" class="mt-1 text-lg text-slate-700"></p>
        <button
          id="fc-speak"
          type="button"
          class="mt-4 rounded-full bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700"
        >
          🔊 Nghe
        </button>
      </div>
      <p id="fc-hint" class="mt-4 text-sm text-slate-400">Bấm vào thẻ để xem đáp án</p>
    </div>

    <div id="fc-actions" class="mt-4 hidden grid-cols-3 gap-3">
      <button
        id="fc-again"
        type="button"
        class="rounded-xl border border-red-300 bg-red-50 py-3 font-semibold text-red-700 transition hover:bg-red-100"
      >
        😓 Học lại
      </button>
      <button
        id="fc-good"
        type="button"
        class="rounded-xl border border-amber-300 bg-amber-50 py-3 font-semibold text-amber-700 transition hover:bg-amber-100"
      >
        🙂 Được
      </button>
      <button
        id="fc-easy"
        type="button"
        class="rounded-xl border border-green-300 bg-green-50 py-3 font-semibold text-green-700 transition hover:bg-green-100"
      >
        😄 Dễ
      </button>
    </div>

    <div
      id="fc-done"
      class="mt-6 hidden rounded-3xl border border-green-200 bg-green-50 p-8 text-center"
    >
      <p class="hanzi text-5xl">💪</p>
      <h2 class="mt-3 text-xl font-bold text-green-800">Hết thẻ đến hạn hôm nay!</h2>
      <p class="mt-1 text-sm text-green-600">Quay lại ngày mai hoặc chọn cấp độ khác.</p>
      <button
        id="fc-reset"
        type="button"
        class="mt-4 rounded-xl border border-green-300 bg-white px-4 py-2 text-sm font-semibold text-green-700 hover:bg-green-100"
      >
        Học lại từ đầu (xóa tiến độ)
      </button>
    </div>
  </div>

  <script>
    const INTERVALS = [0, 1, 2, 4, 8, 16, 32];
    const STORE_KEY = 'tiengtrung-flashcard-progress';
    const $ = (id) => document.getElementById(id)!;

    let vocab: any[] = [];
    let deck: any[] = [];
    let idx = 0;
    let progress: Record<string, { box: number; due: string }> = {};

    try {
      progress = JSON.parse(localStorage.getItem(STORE_KEY) || '{}');
    } catch {
      progress = {};
    }

    function todayStr() {
      return new Date().toISOString().slice(0, 10);
    }

    function saveProgress() {
      localStorage.setItem(STORE_KEY, JSON.stringify(progress));
    }

    function addDays(days: number) {
      const d = new Date();
      d.setDate(d.getDate() + days);
      return d.toISOString().slice(0, 10);
    }

    function isDue(id: string) {
      const p = progress[id];
      return !p || p.box === 0 || p.due <= todayStr();
    }

    function buildDeck() {
      const level = ($('fc-level') as HTMLSelectElement).value;
      const pool = level ? vocab.filter((v) => v.level === level) : vocab;
      deck = pool.filter((v) => isDue(v.id));
      idx = 0;
      updateStats(pool);
      if (deck.length === 0) {
        $('fc-card').classList.add('hidden');
        $('fc-actions').classList.add('hidden');
        $('fc-actions').classList.remove('grid');
        $('fc-done').classList.remove('hidden');
      } else {
        $('fc-card').classList.remove('hidden');
        $('fc-done').classList.add('hidden');
        showCard();
      }
    }

    function updateStats(pool: any[]) {
      $('fc-total').textContent = String(pool.length);
      $('fc-due').textContent = String(pool.filter((v) => isDue(v.id)).length);
      $('fc-learned').textContent = String(
        Object.values(progress).filter((p) => p.box >= 4).length,
      );
    }

    function showCard() {
      const card = deck[idx % deck.length];
      $('fc-hanzi').textContent = card.hanzi;
      $('fc-hanzi').classList.remove('hidden');
      $('fc-pinyin').textContent = card.pinyin;
      $('fc-meaning').textContent = card.meaning_vi;
      $('fc-back').classList.add('hidden');
      $('fc-hint').classList.remove('hidden');
      $('fc-actions').classList.add('hidden');
      $('fc-actions').classList.remove('grid');
      ($('fc-card') as HTMLElement).dataset.id = card.id;
      ($('fc-card') as HTMLElement).dataset.audio = card.audio || '';
    }

    function reveal() {
      $('fc-back').classList.remove('hidden');
      $('fc-hint').classList.add('hidden');
      $('fc-actions').classList.remove('hidden');
      $('fc-actions').classList.add('grid');
    }

    function rate(kind: 'again' | 'good' | 'easy') {
      const card = deck[idx % deck.length];
      const p = progress[card.id] || { box: 0, due: todayStr() };
      if (kind === 'again') p.box = 0;
      else if (kind === 'good') p.box = Math.min(p.box + 1, INTERVALS.length - 1);
      else p.box = Math.min(p.box + 2, INTERVALS.length - 1);
      p.due = addDays(INTERVALS[p.box]);
      progress[card.id] = p;
      saveProgress();
      idx++;
      if (idx >= deck.length) buildDeck();
      else showCard();
    }

    $('fc-card').addEventListener('click', reveal);
    $('fc-again').addEventListener('click', () => rate('again'));
    $('fc-good').addEventListener('click', () => rate('good'));
    $('fc-easy').addEventListener('click', () => rate('easy'));
    $('fc-level').addEventListener('change', buildDeck);
    $('fc-reset').addEventListener('click', () => {
      if (confirm('Xóa toàn bộ tiến độ flashcard?')) {
        progress = {};
        saveProgress();
        buildDeck();
      }
    });
    $('fc-speak').addEventListener('click', (e) => {
      e.stopPropagation();
      const src = ($('fc-card') as HTMLElement).dataset.audio;
      if (src) new Audio(src).play().catch(() => {});
    });

    fetch('/data/content.json')
      .then((r) => r.json())
      .then((data) => {
        vocab = data.vocabulary;
        buildDeck();
      });
  </script>
</BaseLayout>
