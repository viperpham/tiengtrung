---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const quizzes = await getCollection('quizzes');
  return quizzes.map((q) => ({
    params: { id: q.id },
    props: { quiz: { id: q.id, ...q.data } },
  }));
}

const { quiz } = Astro.props;
---

<BaseLayout title={`${quiz.title} — Quiz tiếng Trung`}>
  <nav class="text-sm text-slate-500">
    <a href={`/hsk/${quiz.level.toLowerCase()}`} class="hover:text-red-600">{quiz.level}</a>
    <span class="mx-1">/</span>
    <span class="font-medium text-slate-700">{quiz.title}</span>
  </nav>

  <div id="quiz-app" class="mx-auto mt-6 max-w-2xl">
    <div id="quiz-progress" class="mb-4 flex items-center justify-between text-sm text-slate-500">
      <span id="quiz-counter"></span>
      <span>Điểm: <strong id="quiz-score" class="text-red-600">0</strong></span>
    </div>
    <div class="h-2 overflow-hidden rounded-full bg-slate-200">
      <div id="quiz-bar" class="h-full rounded-full bg-red-600 transition-all" style="width: 0%"></div>
    </div>

    <div class="mt-6 rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
      <h1 id="quiz-question" class="hanzi text-2xl font-bold leading-relaxed text-slate-900"></h1>
      <div id="quiz-options" class="mt-6 grid gap-3"></div>
      <div id="quiz-feedback" class="mt-4 hidden rounded-xl p-4 text-sm"></div>
      <button
        id="quiz-next"
        type="button"
        class="mt-6 hidden w-full rounded-xl bg-red-600 py-3 font-semibold text-white transition hover:bg-red-700"
      >
        Câu tiếp theo →
      </button>
    </div>

    <div
      id="quiz-result"
      class="mt-6 hidden rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm"
    >
      <p class="hanzi text-5xl">🎉</p>
      <h2 class="mt-3 text-2xl font-bold text-slate-900">Hoàn thành!</h2>
      <p class="mt-2 text-slate-600">Bạn trả lời đúng <strong id="result-score" class="text-red-600"></strong>/<span id="result-total"></span> câu</p>
      <p id="result-msg" class="mt-2 text-sm text-slate-500"></p>
      <div class="mt-6 flex justify-center gap-3">
        <button
          id="quiz-retry"
          type="button"
          class="rounded-xl bg-red-600 px-6 py-3 font-semibold text-white transition hover:bg-red-700"
        >
          Làm lại
        </button>
        <a
          href={`/hsk/${quiz.level.toLowerCase()}`}
          class="rounded-xl border border-slate-300 px-6 py-3 font-semibold text-slate-700 transition hover:bg-slate-50"
        >
          Về bài học
        </a>
      </div>
    </div>
  </div>

  <script define:vars={{ quiz }}>
    let current = 0;
    let score = 0;
    let answered = false;

    const $ = (id) => document.getElementById(id);

    function renderQuestion() {
      answered = false;
      const q = quiz.questions[current];
      $('quiz-counter').textContent = `Câu ${current + 1}/${quiz.questions.length}`;
      $('quiz-bar').style.width = `${(current / quiz.questions.length) * 100}%`;
      $('quiz-question').textContent = q.question;
      $('quiz-feedback').classList.add('hidden');
      $('quiz-next').classList.add('hidden');

      const opts = $('quiz-options');
      opts.innerHTML = '';
      q.options.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className =
          'rounded-xl border border-slate-300 px-5 py-3 text-left font-medium text-slate-700 transition hover:border-red-400 hover:bg-red-50';
        btn.textContent = opt;
        btn.addEventListener('click', () => {
          if (answered) return;
          answered = true;
          const correct = i === q.answer;
          if (correct) {
            score++;
            $('quiz-score').textContent = score;
            btn.className =
              'rounded-xl border border-green-500 bg-green-50 px-5 py-3 text-left font-medium text-green-800';
          } else {
            btn.className =
              'rounded-xl border border-red-500 bg-red-50 px-5 py-3 text-left font-medium text-red-800';
            opts.children[q.answer].className =
              'rounded-xl border border-green-500 bg-green-50 px-5 py-3 text-left font-medium text-green-800';
          }
          const fb = $('quiz-feedback');
          fb.classList.remove('hidden');
          fb.classList.add(correct ? 'bg-green-50' : 'bg-amber-50');
          fb.textContent = (correct ? '✔ Chính xác! ' : '✘ Chưa đúng. ') + (q.explanation || '');
          $('quiz-next').classList.remove('hidden');
          $('quiz-next').textContent =
            current === quiz.questions.length - 1 ? 'Xem kết quả' : 'Câu tiếp theo →';
        });
        opts.appendChild(btn);
      });
    }

    function showResult() {
      $('quiz-progress').classList.add('hidden');
      $('quiz-app').querySelector('.rounded-3xl.border').classList.add('hidden');
      $('quiz-result').classList.remove('hidden');
      $('result-score').textContent = score;
      $('result-total').textContent = quiz.questions.length;
      const ratio = score / quiz.questions.length;
      $('result-msg').textContent =
        ratio === 1
          ? 'Tuyệt vời! 太棒了！'
          : ratio >= 0.6
            ? 'Khá tốt! Cố gắng thêm nhé!'
            : 'Đừng nản — học lại từ vựng rồi thử lần nữa nhé!';
    }

    $('quiz-next').addEventListener('click', () => {
      current++;
      if (current >= quiz.questions.length) showResult();
      else renderQuestion();
    });

    $('quiz-retry').addEventListener('click', () => {
      current = 0;
      score = 0;
      $('quiz-score').textContent = '0';
      $('quiz-result').classList.add('hidden');
      $('quiz-progress').classList.remove('hidden');
      $('quiz-app').querySelector('.rounded-3xl.border').classList.remove('hidden');
      renderQuestion();
    });

    renderQuestion();
  </script>
</BaseLayout>
