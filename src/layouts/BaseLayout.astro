---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Học tiếng Trung', description = 'Website học tiếng Trung theo trình độ HSK — từ vựng, ngữ pháp, quiz và flashcard.' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Trang chủ' },
  { href: '/flashcards', label: 'Flashcard' },
];

const levels = [
  ['HSK1', 'HSK 1'],
  ['HSK2', 'HSK 2'],
  ['HSK3', 'HSK 3'],
  ['HSK4', 'HSK 4'],
  ['HSK5', 'HSK 5'],
  ['HSK6', 'HSK 6'],
];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
      <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex items-center gap-2 text-lg font-bold text-slate-900">
          <span class="hanzi rounded-lg bg-red-600 px-2 py-1 text-white">中</span>
          Học tiếng Trung
        </a>
        <div class="flex items-center gap-1 overflow-x-auto text-sm">
          {
            navLinks.map(({ href, label }) => (
              <a
                href={href}
                class="rounded-lg px-3 py-2 font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900"
              >
                {label}
              </a>
            ))
          }
          <div class="group relative">
            <button
              class="rounded-lg px-3 py-2 font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900"
              type="button"
            >
              HSK ▾
            </button>
            <div
              class="invisible absolute right-0 z-50 w-44 rounded-xl border border-slate-200 bg-white p-2 opacity-0 shadow-lg transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
            >
              {
                levels.map(([code, label]) => (
                  <a
                    href={`/hsk/${code.toLowerCase()}`}
                    class="block rounded-lg px-3 py-2 text-slate-600 hover:bg-red-50 hover:text-red-700"
                  >
                    {label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>

    <footer class="mt-12 border-t border-slate-200 bg-white py-6 text-center text-sm text-slate-500">
      <p>Học tiếng Trung mỗi ngày · 稳步前进</p>
      <a href="/admin" class="mt-1 inline-block text-xs text-slate-400 hover:text-slate-600">Admin</a>
    </footer>
  </body>
</html>
